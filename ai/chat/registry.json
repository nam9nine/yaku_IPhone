    {
      "id": "majima-kiryu",
      "kind": "fact",
      "text": "마지마는 키류에게 강한 집착을 보이며 구실을 찾아 싸움을 걸곤 한다.",
      "known_by": ["majima"],
      "scenarios": ["daily-if-v1"],
      "runtime_eligible": true,
      "approval": "agent-reviewed-experiment",
      "split": null,
      "source": {
